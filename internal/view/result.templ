package view

import "github.com/dev-labs-ai/weather-panel/internal/weather"

// Result shows the conditions at the resolved location. The location comes first because an ambiguous name resolves
// to the first match, and the user needs to see which place that was. Temperature and condition lead the readings;
// every value has a text label, so nothing depends on an icon or a color.
templ Result(r weather.Report) {
	<article>
		<h2>
			<span>Agora em</span>
			{ formatLocation(r.Location) }
		</h2>
		<dl>
			<div>
				<dt>Temperatura</dt>
				<dd>{ formatTemperature(r.Conditions.TemperatureC) }</dd>
			</div>
			<div>
				<dt>Condição</dt>
				<dd>{ weather.ConditionDescription(r.Conditions.WeatherCode) }</dd>
			</div>
		</dl>
		<dl>
			<div>
				<dt>Sensação térmica</dt>
				<dd>{ formatTemperature(r.Conditions.ApparentTemperatureC) }</dd>
			</div>
			<div>
				<dt>Umidade</dt>
				<dd>{ formatHumidity(r.Conditions.RelativeHumidityPct) }</dd>
			</div>
			<div>
				<dt>Vento</dt>
				<dd>{ formatWindSpeed(r.Conditions.WindSpeedKmh) }</dd>
			</div>
		</dl>
		// The CC BY 4.0 license requires the attribution next to the data.
		<p>
			Dados meteorológicos por <a href="https://open-meteo.com/">Open-Meteo.com</a>
		</p>
	</article>
}

// ValidationMessage explains why the input cannot be searched. Its text element has the id city-error, which the
// input's aria-describedby points at, so the message is also read as the input's description.
templ ValidationMessage(message string) {
	@messageBox("Confira o nome da cidade") {
		<p id="city-error">{ message }</p>
	}
}

// NotFoundMessage says that no place matches the name and invites a new search.
templ NotFoundMessage() {
	@messageBox("Cidade não encontrada") {
		<p>Não encontramos nenhuma cidade com esse nome. Confira a grafia ou tente uma cidade próxima e busque de novo.</p>
	}
}

// UnavailableMessage says that the weather data cannot be fetched right now, without naming the cause, and invites
// a retry.
templ UnavailableMessage() {
	@messageBox("Clima indisponível no momento") {
		<p>Não conseguimos obter os dados meteorológicos agora. Aguarde alguns instantes e busque de novo.</p>
	}
}

// messageBox gives every message the same shape: a heading that says what went wrong and text that says what to do.
templ messageBox(title string) {
	<div>
		<h2>{ title }</h2>
		{ children... }
	</div>
}
